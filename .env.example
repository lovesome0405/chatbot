# 최소 설정. 복사: cp .env.example .env  (실제 키는 .env에만, Git 제외)
DATABASE_URL=postgresql://rag:rag@127.0.0.1:54329/rag
# Supabase 별도 DB 예: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# 임베딩: fake(CI) | e5-onnx(실제 multilingual-e5-small, scripts/fetch_e5.py로 내려받기)
RAG_EMBEDDER=e5-onnx
RAG_E5_MODEL_DIR=models/multilingual-e5-small
RAG_E5_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# 생성: fake | ollama  (생성 모델과 임베딩 모델은 서로 독립 설정)
RAG_GENERATOR=ollama
OLLAMA_URL=http://127.0.0.1:11434
# 상업 이용 제한 없는 Apache 2.0 모델만(v0.5.0). qwen2.5:3b 는 비상업 라이선스라 쓰지 않는다
OLLAMA_MODEL=qwen2.5:1.5b
# 실시간 생성 시간 상한(초). 넘으면 근거 원문 발췌로 답한다. 답 길이 상한(토큰), 인용 방식(short|full)
RAG_GEN_BUDGET_S=8
RAG_GEN_MAX_TOKENS=160
RAG_QUOTE_STYLE=short
# 미리 만든 답(ragcore.cli warm, 밤 작업)용 모델과 사용 여부
RAG_WARM_MODEL=qwen3:4b
RAG_ANSWER_CACHE=1

# 검색 시작값 (평가로 조정)
RAG_RETRIEVAL_MODE=hybrid
RAG_KEYWORD_TOP_N=10
RAG_VECTOR_TOP_N=10
RAG_RRF_K=60
RAG_FINAL_TOP_K=4
# 원본당 근거 조각 상한. 2로 낮춘 run4가 run3보다 나빠 상한 없음(=final_top_k)으로 둠
RAG_MAX_CHUNKS_PER_SOURCE=4

# 앱 자격 → 프로젝트 범위 (서버가 결정. 요청 본문으로 범위를 바꿀 수 없음)
RAG_APP_KEYS=lolypoly:change-me-lolypoly-key,maru:change-me-maru-key
# 정적 웹 공개 중계: 이 프로젝트에만 묶임
RAG_PUBLIC_PROJECT=maru
RAG_PUBLIC_ORIGINS=http://127.0.0.1:8765
# 평가·데모에서만 기준 시각 덮어쓰기 허용
RAG_ALLOW_REFERENCE_TIME=0
