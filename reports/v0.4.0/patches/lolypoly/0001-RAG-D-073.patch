diff --git a/campus/management/commands/export_rag.py b/campus/management/commands/export_rag.py
new file mode 100644
index 0000000..cb4bad2
--- /dev/null
+++ b/campus/management/commands/export_rag.py
@@ -0,0 +1,98 @@
+"""공개 수집 결과(식단·학사일정·공지)를 공통 RAG 엔진 적재용 JSON 으로 내보낸다 (D-073).
+
+    python manage.py export_rag --out /경로/lolypoly-rag-export.json
+
+- 허용 필드만 내보낸다. 계정·커뮤니티·택시방·의견·사진·버스는 내보내지 않는다.
+- 각 행의 collected_at(실제 수집 시각)을 그대로 쓴다. 날짜를 오늘로 바꾸지 않는다.
+- 수집 종류별 마지막 실행 결과(success/failed)와 마지막 성공 시각을 함께 적는다. 엔진은 failed 인 종류의 삭제를 반영하지 않아
+  마지막 성공 데이터가 유지된다(DB 도 실패한 수집으로 기존 행을 바꾸지 않는다).
+- 파일은 임시 파일에 쓴 뒤 바꿔 넣는다(엔진이 반쯤 쓴 파일을 읽지 않게).
+엔진 쪽 적재: RAG_LOLYPOLY_EXPORT=<이 파일> python -m ragcore.cli ingest --project lolypoly
+"""
+
+import json
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+
+from django.conf import settings
+from django.core.management.base import BaseCommand
+from django.utils import timezone
+
+from campus.models import AcademicEvent, CollectionRun, Meal, Notice
+
+PUBLIC_FIELDS = {
+    "meals": ["date", "meal_type", "items", "source_url", "collected_at"],
+    "events": ["title", "course", "start_date", "end_date", "source_year", "source_url", "collected_at"],
+    "notices": ["post_id", "title", "category", "author", "posted_on", "is_pinned", "source_url", "collected_at"],
+}
+MODELS = {"meals": Meal, "events": AcademicEvent, "notices": Notice}
+EXCLUDED = ["accounts", "community", "taxi", "feedback", "bus", "photos"]
+
+
+def _iso(v):
+    return v.isoformat() if hasattr(v, "isoformat") else v
+
+
+def _commit() -> str:
+    try:
+        out = subprocess.run(["git", "-C", str(settings.BASE_DIR), "rev-parse", "HEAD"], capture_output=True, text=True, timeout=5)
+        if out.returncode == 0 and out.stdout.strip():
+            return out.stdout.strip()
+    except (OSError, subprocess.SubprocessError):
+        pass
+    return "VERSION-" + (Path(settings.BASE_DIR) / "VERSION").read_text(encoding="utf-8").strip()
+
+
+def collection_status(source: str) -> dict:
+    runs = CollectionRun.objects.filter(source=source).exclude(status=CollectionRun.Status.RUNNING)
+    last = runs.first()
+    ok = runs.filter(status=CollectionRun.Status.SUCCESS).first()
+    return {
+        "last_run_status": last.status if last else "never",
+        "last_run_at": _iso(last.finished_at) if last else None,
+        "last_success_at": _iso(ok.finished_at) if ok else None,
+    }
+
+
+def build_export(source_label: str = "lolypoly-db") -> dict:
+    out = {
+        "provenance": {
+            "kind": "repository_data",
+            "source": source_label,
+            "format": 2,
+            "description": "LOLYPOLY 수집 DB의 공개 필드(식단·학사일정·공지). 각 행의 collected_at 은 실제 수집 시각",
+            "lolypoly_commit": _commit(),
+            "exported_at": _iso(timezone.now()),
+            "schema": PUBLIC_FIELDS,
+            "excluded": EXCLUDED,
+            "collections": {k: collection_status(k) for k in MODELS},
+        }
+    }
+    for key, model in MODELS.items():
+        out[key] = [{f: _iso(getattr(obj, f)) for f in PUBLIC_FIELDS[key]} for obj in model.objects.all()]
+    return out
+
+
+def write_atomic(path: Path, data: dict):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".rag-export-", dir=path.parent)
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        json.dump(data, f, ensure_ascii=False, indent=1)
+    os.replace(tmp, path)
+
+
+class Command(BaseCommand):
+    help = "공개 수집 결과(식단·학사일정·공지)를 RAG 엔진 적재용 JSON 으로 내보냅니다."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--out", required=True, help="내보낼 JSON 파일 경로")
+        parser.add_argument("--source-label", default="lolypoly-db", help="provenance.source 값(재현 도구는 fixture)")
+
+    def handle(self, *args, out, source_label, **options):
+        data = build_export(source_label)
+        write_atomic(Path(out), data)
+        counts = {k: len(data[k]) for k in MODELS}
+        status = {k: v["last_run_status"] for k, v in data["provenance"]["collections"].items()}
+        self.stdout.write(self.style.SUCCESS(f"[내보냄] {out} {counts} 수집 상태 {status}"))
diff --git a/campus/rag.py b/campus/rag.py
new file mode 100644
index 0000000..aef3740
--- /dev/null
+++ b/campus/rag.py
@@ -0,0 +1,88 @@
+"""롤리폴리 안내(RAG) 연결 — 서버 측에서만 공통 RAG 엔진을 부른다 (D-073).
+
+흐름: 브라우저 → 같은 출처 POST /assistant/ask/ (CSRF 검사) → 여기 ask() → RAG 엔진 POST /v1/chat (Bearer 앱 키)
+- API 주소·앱 키는 서버 환경변수(LOLYPOLY_RAG_API_URL, LOLYPOLY_RAG_APP_KEY)에만 둔다. 화면·브라우저에 보내지 않는다.
+- 둘 중 하나라도 비어 있으면 기능이 꺼진다(화면에 안내 칸을 그리지 않음).
+- 지금 질문 한 개만 보낸다. 대화 기록·로그인 정보·커뮤니티·의견 같은 개인 데이터는 보내지 않는다.
+- 엔진 응답은 공통 계약(status, route, answer, citations, as_of, request_id)을 그대로 쓰되, 링크는 http(s)만 남긴다.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+
+from django.conf import settings
+
+logger = logging.getLogger("campus.rag")
+
+STATUSES = {"answered", "partial", "insufficient_evidence", "clarification_needed", "unavailable"}
+SOURCE_LABELS = {"public_original": "공식 원문", "repository_data": "앱 수집 자료", "synthetic": "합성 테스트 자료"}
+MAX_QUESTION = 500
+
+
+@dataclass
+class RagError(Exception):
+    """엔진에 닿지 못했거나 엔진이 요청을 거부함. kind: timeout | network | rejected | rate_limited | bad_response"""
+    kind: str
+    http_status: int | None = None
+
+
+def is_enabled() -> bool:
+    return bool(settings.LOLYPOLY_RAG_API_URL and settings.LOLYPOLY_RAG_APP_KEY)
+
+
+def _safe_url(url) -> str | None:
+    return url if isinstance(url, str) and url.startswith(("https://", "http://")) else None
+
+
+def clean_response(data: dict) -> dict:
+    """엔진 응답을 화면용으로 좁힌다. 모르는 상태는 unavailable 로, 링크는 웹 주소만."""
+    status = data.get("status") if data.get("status") in STATUSES else "unavailable"
+    cites = []
+    for c in data.get("citations") or []:
+        if not isinstance(c, dict):
+            continue
+        cites.append({
+            "title": str(c.get("title") or ""),
+            "url": _safe_url(c.get("url")),
+            "quote": str(c.get("quote") or "")[:400],
+            "locator": str(c.get("locator") or ""),
+            "as_of": str(c.get("as_of") or ""),
+            "source_type": str(c.get("source_type") or ""),
+            "source_label": SOURCE_LABELS.get(c.get("source_type"), "자료"),
+            "note": str(c.get("note") or ""),
+        })
+    return {"status": status, "route": str(data.get("route") or ""), "answer": str(data.get("answer") or ""),
+            "citations": cites, "as_of": str(data.get("as_of") or ""), "request_id": str(data.get("request_id") or "")}
+
+
+def ask(question: str, language: str = "ko") -> dict:
+    """질문 하나를 엔진에 보낸다. 실패는 RagError 로 알린다(장애 문구를 답변처럼 만들지 않는다)."""
+    url = settings.LOLYPOLY_RAG_API_URL.rstrip("/") + "/v1/chat"
+    body = json.dumps({"question": question[:MAX_QUESTION], "language": language, "context": {}}).encode()
+    req = urllib.request.Request(url, data=body, method="POST", headers={
+        "Content-Type": "application/json", "Authorization": f"Bearer {settings.LOLYPOLY_RAG_APP_KEY}"})
+    t0 = time.monotonic()
+    try:
+        with urllib.request.urlopen(req, timeout=settings.LOLYPOLY_RAG_TIMEOUT_SEC) as r:
+            data = json.loads(r.read().decode("utf-8"))
+            timing = r.headers.get("Server-Timing", "")
+    except urllib.error.HTTPError as exc:
+        kind = "rate_limited" if exc.code == 429 else "rejected"
+        logger.warning("rag http %s", exc.code)
+        raise RagError(kind, exc.code) from None
+    except TimeoutError:
+        raise RagError("timeout") from None
+    except urllib.error.URLError as exc:
+        raise RagError("timeout" if isinstance(exc.reason, TimeoutError) else "network") from None
+    except (ValueError, UnicodeDecodeError):
+        raise RagError("bad_response") from None
+    # 질문 원문은 남기지 않는다. 구간 지연만(엔진 Server-Timing + 앱→엔진 왕복)
+    logger.info("rag ok request_id=%s status=%s app_ms=%.0f engine=%s", data.get("request_id"), data.get("status"),
+                (time.monotonic() - t0) * 1000, timing)
+    return clean_response(data)
